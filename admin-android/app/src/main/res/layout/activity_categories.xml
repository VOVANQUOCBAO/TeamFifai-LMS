<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F6FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="QUẢN LÝ DANH MỤC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#263580"
        android:gravity="center"
        android:padding="12dp" />

    <EditText
        android:id="@+id/edtSearchCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tìm kiếm danh mục..."
        android:singleLine="true"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnAddCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Thêm danh mục" />

    <TextView
        android:id="@+id/tvCategoryCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tổng số danh mục: 0"
        android:textStyle="bold"
        android:padding="10dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
